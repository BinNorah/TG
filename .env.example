# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:replace_with_bot_token
TELEGRAM_OWNER_ID=123456789

# Userbot Pyrogram (obtain from my.telegram.org)
PYROGRAM_API_ID=123456
PYROGRAM_API_HASH=replace_with_api_hash
# Use a Railway variable for production; generate locally with generar_session_string.py
PYROGRAM_SESSION_STRING=
PYROGRAM_SESSION_NAME=mi_sesion

# Railway: set DATA_DIR to the mounted volume path (for example /data).
# Local development defaults to ./data when this variable is unset.
DATA_DIR=

# Fixed public labels and links used in bot messages
BOT_PUBLIC_USERNAME=@Flamie_SpeeddrawBot
BOT_PUBLIC_LINK=https://t.me/Flamie_SpeeddrawBot
OWNER_DISPLAY_NAME=MsTarantula
OWNER_ALIAS=@MsTarantula

# Optional external translation instance
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
